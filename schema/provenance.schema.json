{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/raulprtech/provenance-spec/v0.1.0-draft/schema/provenance.schema.json",
  "title": "Observable human-AI decision provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "title",
    "created_at",
    "scope",
    "participants",
    "sources",
    "artifacts",
    "evidence",
    "decisions",
    "limits",
    "redactions"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_id": {"$ref": "#/$defs/id"},
    "title": {"$ref": "#/$defs/nonEmpty"},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "intended_use", "exclusions"],
      "properties": {
        "description": {"$ref": "#/$defs/nonEmpty"},
        "intended_use": {"$ref": "#/$defs/nonEmpty"},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}}
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "display_name", "declaration_class", "declared_by"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["human", "ai_system", "tool", "organization"]},
          "display_name": {"$ref": "#/$defs/nonEmpty"},
          "declaration_class": {"$ref": "#/$defs/classification"},
          "declared_by": {"$ref": "#/$defs/nonEmpty"},
          "role": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "locator", "classification"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "title": {"$ref": "#/$defs/nonEmpty"},
          "kind": {"enum": ["standard", "paper", "web", "repository", "user_record", "tool_output", "other"]},
          "locator": {"$ref": "#/$defs/nonEmpty"},
          "classification": {"$ref": "#/$defs/classification"},
          "accessed_at": {"type": "string", "format": "date"},
          "notes": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "media_type", "role", "verification", "sha256", "size_bytes"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"$ref": "#/$defs/nonEmpty"},
          "media_type": {"$ref": "#/$defs/nonEmpty"},
          "role": {"$ref": "#/$defs/nonEmpty"},
          "verification": {"const": "tool_verified"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceItem"}
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "status", "decided_at", "decision_maker_refs", "rationale_summary", "alternatives", "evidence_refs", "artifact_refs", "limits"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "summary": {"$ref": "#/$defs/nonEmpty"},
          "status": {"enum": ["proposed", "accepted", "rejected", "deferred"]},
          "decided_at": {"type": "string", "format": "date-time"},
          "decision_maker_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
          "rationale_summary": {"$ref": "#/$defs/nonEmpty"},
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "disposition", "reason"],
              "properties": {
                "label": {"$ref": "#/$defs/nonEmpty"},
                "disposition": {"enum": ["selected", "rejected", "deferred", "not_evaluated"]},
                "reason": {"$ref": "#/$defs/nonEmpty"}
              }
            }
          },
          "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "artifact_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "limits": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}}
        }
      }
    },
    "limits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["json_pointer", "reason", "replacement"],
        "properties": {
          "json_pointer": {"type": "string"},
          "reason": {"const": "potential_secret"},
          "replacement": {"const": "[REDACTED]"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "classification": {"enum": ["observed", "user_declared", "tool_verified", "system_inferred"]},
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "statement", "recorded_by", "source_refs", "artifact_refs", "limits"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "classification": {"$ref": "#/$defs/classification"},
        "statement": {"$ref": "#/$defs/nonEmpty"},
        "recorded_by": {"$ref": "#/$defs/id"},
        "occurred_at": {"type": "string", "format": "date-time"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "artifact_refs": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "inference_basis": {"type": "string", "minLength": 1},
        "limits": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "system_inferred"}}},
          "then": {"required": ["inference_basis"], "properties": {"limits": {"minItems": 1}}},
          "else": {"not": {"required": ["inference_basis"]}}
        }
      ]
    }
  }
}

